# Copy to .env and load it however you prefer (the gateway reads plain environment
# variables - it does not parse this file itself).

# --- upstream -----------------------------------------------------------------
# live = forward to the real provider. mock = synthesize replies locally, so the
# whole pipeline demos with no network and no key.
DLP_UPSTREAM_MODE=mock
DLP_PORT=8080

# Used when a client does not present its own credential (API-gateway mode).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- the semantic judge -------------------------------------------------------
# provider=anthropic uses the official SDK. provider=local talks to any
# OpenAI-compatible server the organization runs itself - the data-residency path.
DLP_JUDGE_PROVIDER=anthropic
DLP_JUDGE_MODEL=claude-opus-5
DLP_JUDGE_EFFORT=low
DLP_JUDGE_TIMEOUT_MS=12000

# On-prem judging: nothing, not even the classification request, leaves the tenant.
# DLP_JUDGE_PROVIDER=local
# DLP_JUDGE_BASE_URL=http://llm.internal:8000/v1
# DLP_JUDGE_MODEL=google/gemma-4-26b-a4b-it

# Demo stand-in: the same open model, hosted, impersonating the on-prem one.
# Identical code path - only the hostname differs. The gateway detects this and
# labels it STAND-IN everywhere, because during the demo prompt text really does
# leave the network. Declare it on stage.
# DLP_JUDGE_PROVIDER=local
# DLP_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# DLP_JUDGE_MODEL=google/gemma-4-26b-a4b-it:free
# DLP_JUDGE_API_KEY=sk-or-...

# --- vault --------------------------------------------------------------------
# 32 bytes of hex. Without it the gateway uses an ephemeral key and placeholder
# mappings die with the process. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DLP_VAULT_KEY=
DLP_VAULT_TTL_MS=43200000

# --- policy and audit ---------------------------------------------------------
DLP_POLICY=./policy.yaml
DLP_AUDIT_LOG=./data/audit.jsonl
DLP_ESCALATION_TIMEOUT_MS=90000

# DEMO ONLY. Sends pre-sanitization text to the dashboard so the split-screen view
# works. Set to false in any real deployment.
DLP_DASHBOARD_PLAINTEXT=true
