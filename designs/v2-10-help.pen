              "children": [
                {
                  "type": "frame",
                  "id": "HRHUz",
                  "name": "You didn’t install anything",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "icon",
                      "id": "Qapa9",
                      "name": "Icon",
                      "width": 20,
                      "height": 20,
                      "icon": "package-x",
                      "library": "lucide",
                      "fill": "$hz-accent"
                    },
                    {
                      "type": "text",
                      "id": "w5RsQr",
                      "name": "Fact Title",
                      "fill": "$hz-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "You didn’t install anything",
                      "lineHeight": 1.2,
                      "fontFamily": "$hz-serif",
                      "fontSize": 26,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "ZrPxj",
                      "name": "Fact Body",
                      "fill": "$hz-text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "There is no app, browser extension or setting on your laptop or VDI. Your company routes traffic bound for AI assistants through Hajiz inside its own network, so you keep using claude.ai and chatgpt.com exactly as before.",
                      "lineHeight": 1.55,
                      "fontFamily": "$hz-sans",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Lkv8g",
                  "name": "You can’t switch it off",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "icon",
                      "id": "aB1YB",
                      "name": "Icon",
                      "width": 20,
                      "height": 20,
                      "icon": "power-off",
                      "library": "lucide",
                      "fill": "$hz-accent"
                    },
                    {
                      "type": "text",
                      "id": "z2jZIZ",
                      "name": "Fact Title",
                      "fill": "$hz-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "You can’t switch it off",
                      "lineHeight": 1.2,
                      "fontFamily": "$hz-serif",
                      "fontSize": 26,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "i1VQnP",
                      "name": "Fact Body",
                      "fill": "$hz-text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Hajiz sits in the network path, not on your device, so there is nothing on your side to disable or bypass. Every prompt from a work device passes through, under the same rules for everyone. Exceptions come only from the security team.",
                      "lineHeight": 1.55,
                      "fontFamily": "$hz-sans",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "XxMlV",
                  "name": "What reviewers see about you",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "icon",
                      "id": "RbEwW",
                      "name": "Icon",
                      "width": 20,
                      "height": 20,
                      "icon": "eye",
                      "library": "lucide",
                      "fill": "$hz-accent"
                    },
