                    {
                      "type": "text",
                      "id": "Wrphy",
                      "name": "Body",
                      "fill": "$hz-text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A record says an IBAN was found, not which IBAN. Prompt text, matched values and the pseudonym map are never written to this log, so the audit trail can't leak what it audits.",
                      "lineHeight": 1.55,
                      "fontFamily": "$hz-sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
