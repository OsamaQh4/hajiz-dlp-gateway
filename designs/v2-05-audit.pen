                      "fill": "$hz-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Every decision, sealed to the one before it.",
                      "lineHeight": 1.08,
                      "fontFamily": "$hz-serif",
                      "fontSize": 52,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "UzlTf",
                      "name": "Lede",
                      "fill": "$hz-text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Each record carries the hash of the record before it, so any edit made after the fact shows up when the chain is walked. Records name the classes of data found, never the values, and the source address rather than a person until an identity source is connected.",
                      "lineHeight": 1.6,
                      "fontFamily": "$hz-sans",
