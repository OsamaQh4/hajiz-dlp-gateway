                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Hajiz sits in your network path. Employees keep opening claude.ai and chatgpt.com, and their prompts pass through this appliance without a setting changed on any machine. That route, and the agent for laptops off the network, carry all of today's traffic.",
                      "lineHeight": 1.6,
                      "fontFamily": "$hz-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
