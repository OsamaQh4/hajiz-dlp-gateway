                  "letterSpacing": 0.6
                },
                {
                  "type": "text",
                  "id": "W1H23",
                  "name": "Title",
                  "fill": "$text-1",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Hajiz sits between you and the assistant. Here is what it does to your prompt, and what to do when it stops one.",
                  "lineHeight": 1.22,
                  "fontFamily": "$font",
                  "fontSize": 32,
                  "fontWeight": "600",
                  "letterSpacing": -0.6
                },
                {
                  "type": "text",
                  "id": "Cr2xO",
                  "name": "Lede",
                  "fill": "$text-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Every prompt you send to ChatGPT or Claude from a work device passes through Hajiz first. Most go straight through untouched. When something sensitive is in the way, Hajiz swaps it out, removes it, asks a person to look, or stops the prompt, and tells you which.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
