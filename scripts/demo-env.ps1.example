# Copy to scripts/demo-env.ps1, put your real key in, then dot-source it in every
# terminal you use:
#
#   . .\scripts\demo-env.ps1
#
# The leading dot matters. Running it without it sets the variables in a child
# process that exits immediately, which is the single easiest way to spend an
# hour wondering why the judge returns 401.
#
# scripts/demo-env.ps1 is gitignored. Do not commit a key.

# --- upstream: mock needs no network and no Anthropic key -------------------
$env:DLP_UPSTREAM_MODE = "mock"

# --- judge: an open model standing in for the on-prem one -------------------
# The ":free" variants are shared and rate-limit hard; the paid endpoint costs
# pennies for a full benchmark run and does not fail mid-demo.
$env:DLP_JUDGE_PROVIDER = "local"
$env:DLP_JUDGE_BASE_URL = "https://openrouter.ai/api/v1"
$env:DLP_JUDGE_MODEL    = "google/gemma-4-26b-a4b-it"

# Reuse OPENROUTER_API_KEY when the terminal already has one, so sourcing this
# file can never overwrite a working key with a stale copy. That exact mistake
# produced 28 straight 401s and a benchmark run that had to be thrown away.
if ($env:OPENROUTER_API_KEY) {
  $env:DLP_JUDGE_API_KEY = $env:OPENROUTER_API_KEY
} else {
  $env:DLP_JUDGE_API_KEY = "sk-or-v1-PUT-YOUR-REAL-KEY-HERE"
}

# --- for the real on-prem judge, use these instead ---------------------------
# $env:DLP_JUDGE_PROVIDER = "local"
# $env:DLP_JUDGE_BASE_URL = "http://llm.internal:8000/v1"
# $env:DLP_JUDGE_MODEL    = "google/gemma-4-26b-a4b-it"
# $env:DLP_JUDGE_API_KEY  = ""

Write-Host "DLP environment set. Verify with: npm run doctor" -ForegroundColor Green
